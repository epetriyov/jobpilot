# JobPilot — шаблон окружения. Скопируйте в .env и заполните.
# .env НИКОГДА не коммитится (constitution IV). Значения — только у владельца.

# ============ ОБЯЗАТЕЛЬНЫЕ (без них сервис не стартует — [F-U1]) ============
# Токен Telegram-бота от @BotFather
TELEGRAM_API_TOKEN=
# Ваш личный chat_id (единственный пользователь). Узнать: напишите @userinfobot
OWNER_CHAT_ID=
# Ключ OpenRouter (один ключ на все модели) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# DSN Postgres. Для docker compose обычно не задаётся вручную (собирается из POSTGRES_* ниже).
# Локальный прогон миграций/скриптов: postgresql+psycopg://jobpilot:jobpilot@localhost:5432/jobpilot
POSTGRES_DSN=

# ============ Postgres (для docker compose) ============
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=jobpilot

# ============ Grafana Cloud (телеметрия в облако; free-аккаунт заводит владелец) ============
# Без этих переменных сервисы работают, телеметрия остаётся локальной (в Alloy).
# Grafana Cloud → Connections → OTLP: endpoint, instance id (user), Access Policy token.
# Пример endpoint: https://otlp-gateway-prod-gb-south-1.grafana.net/otlp
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_TOKEN=
# Метрики самого VPS (prometheus remote_write из Alloy):
# Grafana Cloud → Prometheus: push-URL (.../api/prom/push) и Prometheus instance id.
GCLOUD_HOSTED_METRICS_URL=
GCLOUD_HOSTED_METRICS_ID=

# ============ Поведение ============
# DRY_RUN=true — пайплайн без внешних записей, дайджест помечен «ТЕСТ» (по умолчанию включён)
DRY_RUN=true
TZ_SCHEDULER=Europe/Moscow
DIGEST_SCORE_THRESHOLD=60
DIGEST_MAX_ITEMS=50

# ============ LLM (свап модели = смена строки, без кода) ============
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_SCORING=google/gemini-2.5-flash-lite
LLM_MODEL_SUMMARY=google/gemini-2.5-flash-lite
LLM_MODEL_LETTERS=google/gemini-2.5-pro
LLM_MODEL_JUDGE=google/gemini-2.5-flash
# Фолбэк-прайс, если OpenRouter не вернул фактическую стоимость ($/1M токенов)
PRICE_PER_MTOK_IN=0.10
PRICE_PER_MTOK_OUT=0.40

# ============ Observability (внутри compose менять не нужно) ============
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4317

# ============ GitHub Secrets (НЕ в .env — задаются в репозитории) ============
# ANTHROPIC_API_KEY          — авторевью PR (claude-code-action)
# VPS_HOST, VPS_USER, VPS_SSH_KEY, VPS_APP_DIR — deploy.yml по тегу
# Для provision.sh алертов Grafana: GRAFANA_URL, GRAFANA_SA_TOKEN, METRICS_DS_UID
