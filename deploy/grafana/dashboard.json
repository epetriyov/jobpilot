{
  "__comment": "JobPilot — базовый дашборд этапа 0. Импорт: Grafana Cloud → Dashboards → New → Import → вставить этот JSON, выбрать datasource метрик (Mimir/Prometheus).",
  "title": "JobPilot — Overview",
  "uid": "jobpilot-overview",
  "tags": ["jobpilot"],
  "timezone": "Europe/Moscow",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-24h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Job-прогоны по статусам (rate 1h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (status) (increase(job_runs_total[1h]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Ошибочные прогоны (job failed)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(increase(job_runs_total{status=\"error\"}[24h]))" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Вакансии по источникам (24h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (source) (increase(vacancies_discovered_total[24h]))",
          "legendFormat": "{{source}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Сбои скрейперов по сайтам",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (site) (increase(scraper_failures_total[1h]))",
          "legendFormat": "{{site}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM-токены (in/out, 24h)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (purpose, direction) (increase(llm_tokens_total[24h]))",
          "legendFormat": "{{purpose}} {{direction}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Стоимость LLM, USD (накопительно 24h)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(increase(llm_cost_usd_total[24h]))" }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } }
    }
  ]
}
